# ---- Commerce backend (server/) ----
PORT=8787
# Public HTTPS origin Chord can reach (Fly app URL or an ngrok https URL). No trailing slash.
PUBLIC_BASE_URL=https://adire-lane.fly.dev
# Bearer token Chord sends to /mcp. Generate: openssl rand -hex 24
MCP_TOKEN=
# Owner admin token for /admin. Generate: openssl rand -hex 24
ADMIN_TOKEN=
# Optional. Paystack TEST secret key (sk_test_…). Empty → clearly-labelled simulated checkout.
PAYSTACK_SECRET_KEY=
DB_PATH=./data/adire-lane.db
RESERVATION_MINUTES=30
OFFER_MINUTES=60

# ---- Chord setup scripts (scripts/) ----
CHORD_BASE_URL=https://api.chordhq.xyz
CHORD_API_KEY=
CHORD_WORKSPACE_ID=
CHORD_TEAMMATE_ID=
# Owner-only MCP endpoint token (Owner Brief teammate). Generate: openssl rand -hex 24
OWNER_MCP_TOKEN=
# Signing secret for Chord booking webhooks (whsec_…). Generate: echo whsec_$(openssl rand -hex 24)
CHORD_WEBHOOK_SECRET=
# simulated | paystack_test | chord   (chord = Chord booking tools + Paystack connector, specs/07)
PAYMENT_MODE=simulated
# Optional: email Chord notifies on handover
ESCALATION_EMAIL=
